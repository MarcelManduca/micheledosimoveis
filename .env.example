# Copie este arquivo para `.env` e preencha com os valores do seu projeto Supabase.
# NUNCA faça commit do `.env` real — ele contém chaves e configurações locais.

# ──────────────────────────────────────────────────────────────────────────────
# Variáveis públicas (expostas ao navegador via Vite)
# ──────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<sb_publishable_...>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_ENABLE_LAUNCHES_VERTICAL=""

# ──────────────────────────────────────────────────────────────────────────────
# Variáveis server-side (NÃO expostas ao navegador)
# Usadas pelas server functions / rotas de API durante SSR.
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<sb_publishable_...>"
SUPABASE_PROJECT_ID="<project-ref>"

# Chave secreta de administração (server-only, bypassa RLS para rotas autorizadas).
# ATENÇÃO: NUNCA use prefixo VITE_ nesta variável.
SUPABASE_SECRET_KEY="<sb_secret_...>"

# Compatibilidade legada temporária (se fornecida, tem fallback transparente no client.server)
# SUPABASE_SERVICE_ROLE_KEY="<legacy-or-compatible-server-key>"

# Segredo do webhook que dispara a sincronização diária de imóveis.
# Gere com: `openssl rand -hex 32`
# Configure o mesmo valor no cron / scheduler externo (header `x-sync-secret`).
# ATENÇÃO: NUNCA use prefixo VITE_ nesta variável.
SYNC_WEBHOOK_SECRET="<random-server-only-secret>"

# ──────────────────────────────────────────────────────────────────────────────
# Configurações de Runtime / Deploy (Hostinger VPS / Node Server)
# ──────────────────────────────────────────────────────────────────────────────
NITRO_PRESET="node-server"
NODE_ENV="production"
PORT="3000"
